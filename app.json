{
  "expo": {
    "name": "Zynalive",
    "slug": "zynalive",
    "scheme": "zynalive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zynalive.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Zynalive uses your camera when you go live.",
        "NSMicrophoneUsageDescription": "Zynalive uses your microphone when you go live.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.zynalive.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E0C14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-camera",
        {
          "cameraPermission": "Zynalive uses your camera when you go live.",
          "microphonePermission": "Zynalive uses your microphone when you go live.",
          "recordAudioAndroid": true
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "YOUR_SENTRY_ORG",
          "project": "zynalive"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
