# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app — never put secrets here.
# Server secrets (LiveKit API secret, Stripe, Resend, Upstash, Anthropic) live in Supabase function
# secrets and the agents worker environment. See docs/ENVIRONMENT.md.

# Clerk (auth)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Supabase (Postgres + Realtime + Edge Functions)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# PostHog (analytics)
EXPO_PUBLIC_POSTHOG_KEY=phc_xxx
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (error tracking)
EXPO_PUBLIC_SENTRY_DSN=https://xxx@oYYY.ingest.sentry.io/ZZZ

# ProductBridge (feedback board)
EXPO_PUBLIC_PRODUCTBRIDGE_URL=https://YOUR_BOARD.productbridge.io

# Public web URL (Vercel + your domain); Stripe returns here after checkout
EXPO_PUBLIC_SITE_URL=https://zynalive.example
