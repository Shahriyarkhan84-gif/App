# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the client — never put secrets here.

# Clerk (auth) — https://dashboard.clerk.com → API keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Supabase (backend) — Project settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# PostHog (analytics)
EXPO_PUBLIC_POSTHOG_KEY=phc_xxx
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (error tracking)
EXPO_PUBLIC_SENTRY_DSN=https://xxx@oYYY.ingest.sentry.io/ZZZ

# ProductBridge (feedback) — your public feedback board URL
EXPO_PUBLIC_PRODUCTBRIDGE_URL=https://YOUR_BOARD.productbridge.io

# Public web URL (Vercel deployment / custom domain via Namecheap + Cloudflare)
EXPO_PUBLIC_SITE_URL=https://streamly.example.com
