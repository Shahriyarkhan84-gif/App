# Direct Postgres connection (Supabase: Project settings -> Database -> Connection string, "Session" mode).
# The worker runs as a trusted server-side service; never ship this to a client.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
ANTHROPIC_API_KEY=sk-ant-...
# Default model for every branch; per-branch override e.g. AI_MODEL_MODERATION, AI_MODEL_TRANSLATION.
AI_MODEL=claude-opus-5
AI_CONCURRENCY=4
AI_CEO_EVERY_MIN=60
AI_FRAUD_EVERY_MIN=30
AI_RECS_EVERY_MIN=15
# Which queues this replica runs: all | ai | media. Run media (ffmpeg + Whisper) as its own deployment (Dockerfile.media).
WORKER_QUEUES=all
# Media worker only: Supabase Storage access (service role — server-side only) and encoder settings.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
MEDIA_PRESET=medium
SUBTITLES_MODEL=small
