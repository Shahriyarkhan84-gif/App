{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "creator.zynalive.com"
        }
      ],
      "destination": "/host/dashboard",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "agency.zynalive.com"
        }
      ],
      "destination": "/agency",
      "permanent": false
    },
    {
      "source": "/download/android",
      "destination": "https://expo.dev/artifacts/eas/ulfGVo938K6ExJYctFdLV5bLe7Ym1vT9YlKpFLT3gtQ.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:page(download|creators|agencies|safety|about)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
