{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/download/android",
      "destination": "https://expo.dev/artifacts/eas/Zdy6kiGBlSXaD2_7-vFTbLEH8EvBoJtRq2-AdyZkQ20.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:page(download|creators|agencies|safety|about)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
