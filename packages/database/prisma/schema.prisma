// Prisma translation of supabase/migrations/20260924010000_core.sql and
// 20260924020000_economy.sql. See docs/MIGRATION_PLAN.md for context: this is
// a ground-up rewrite, not a data migration, so ids are regenerated (cuid)
// instead of reusing Clerk's `sub` text ids.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  USER
  HOST
  AGENCY_MEMBER
  AGENCY_ADMIN
  OWNER_ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  active
  restricted
  banned
}

enum RoomCategory {
  chat
  music
  gaming
  talent
  education
  other
}

enum RoomStatus {
  offline
  live
}

enum CoinTxnKind {
  purchase
  gift_sent
  refund
  chargeback
  adjustment
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  disputed
  dispute_lost
}

enum WithdrawalStatus {
  requested
  approved
  rejected
  paid
}

// ---- Identity ---------------------------------------------------------

model User {
  id               String        @id @default(cuid())
  username         String?       @unique
  displayName      String?       @map("display_name")
  avatarUrl        String?       @map("avatar_url")
  bio              String?
  country          String?
  // Country the account was created from (edge geo header, else device
  // region). Set once, never client-editable; decides the pricing region.
  signupCountry    String?       @map("signup_country")
  language         String        @default("en")
  email            String?       @unique
  phone            String?       @unique
  passwordHash     String?       @map("password_hash")
  googleSub        String?       @unique @map("google_sub")
  appleSub         String?       @unique @map("apple_sub")
  refreshTokenHash String?       @map("refresh_token_hash")
  twoFactorSecret  String?       @map("two_factor_secret")
  twoFactorEnabled Boolean       @default(false) @map("two_factor_enabled")
  role             AppRole       @default(USER)
  status           AccountStatus @default(active)
  statusUntil      DateTime?     @map("status_until")
  createdAt        DateTime      @default(now()) @map("created_at")

  host              Host?
  agencyMemberships AgencyMember[]
  managedAgencies   Agency[]          @relation("AgencyManager")
  roomAdmin         RoomAdmin[]
  followers         Follow[]          @relation("Followee")
  following         Follow[]          @relation("Follower")
  blockedBy         UserBlock[]       @relation("Blocked")
  blocking          UserBlock[]       @relation("Blocker")
  messagesSent      Message[]
  dmsSent           DirectMessage[]   @relation("DmSender")
  dmsReceived       DirectMessage[]   @relation("DmRecipient")
  notifications     Notification[]
  wallet            Wallet?
  coinTransactions  CoinTransaction[]
  giftsSent         Gift[]
  payments          Payment[]
  refundRequests    RefundRequest[]
  viewerSessions    Viewer[]
  mediaViews        MediaView[]
  eventScores       EventScore[]
  eventResults      EventResult[]

  @@map("users")
}

// One-time codes for phone sign-in/verification. Never store the raw code —
// codeHash is argon2(code), checked and deleted by AuthService.verifyOtp.
model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("phone_otps")
}

model Agency {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  managerId String?  @map("manager_id")
  manager   User?    @relation("AgencyManager", fields: [managerId], references: [id])
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  members  AgencyMember[]
  hosts    Host[]
  payments Payment[]

  @@map("agencies")
}

model AgencyMember {
  agencyId   String   @map("agency_id")
  userId     String   @map("user_id")
  memberRole String   @map("member_role") // admin | manager | agent
  createdAt  DateTime @default(now()) @map("created_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([agencyId, userId])
  @@map("agency_members")
}

// ---- Hosts & rooms ------------------------------------------------------

model Host {
  userId           String   @id @map("user_id")
  hostCode         String   @unique @map("host_code")
  agencyId         String?  @map("agency_id")
  status           String   @default("active")
  totalLiveSeconds BigInt   @default(0) @map("total_live_seconds")
  createdAt        DateTime @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency         Agency?         @relation(fields: [agencyId], references: [id])
  room           Room?
  streams        Stream[]
  gifts          Gift[]
  creatorEarning CreatorEarning?
  earningEntries EarningEntry[]
  withdrawals    Withdrawal[]
  mediaAssets    MediaAsset[]

  @@index([agencyId])
  @@map("hosts")
}

model Room {
  id                String       @id @default(cuid())
  hostId            String       @unique @map("host_id")
  title             String       @default("Live now")
  category          RoomCategory @default(chat)
  coverUrl          String?      @map("cover_url")
  status            RoomStatus   @default(offline)
  ivsChannelArn     String?      @unique @map("ivs_channel_arn")
  ivsStreamKeyArn   String?      @map("ivs_stream_key_arn")
  ivsPlaybackUrl    String?      @map("ivs_playback_url")
  ivsIngestEndpoint String?      @map("ivs_ingest_endpoint")
  viewerCount       Int          @default(0) @map("viewer_count")
  currentStreamId   String?      @unique @map("current_stream_id")
  currentBattleId   String?      @map("current_battle_id")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  host            Host                 @relation(fields: [hostId], references: [userId], onDelete: Cascade)
  currentStream   Stream?              @relation("CurrentStream", fields: [currentStreamId], references: [id])
  currentBattle   PkBattle?            @relation("CurrentBattle", fields: [currentBattleId], references: [id])
  streams         Stream[]             @relation("RoomStreams")
  admins          RoomAdmin[]
  bans            RoomBan[]
  messages        Message[]
  gifts           Gift[]
  battlesAsA      PkBattle[]           @relation("BattleRoomA")
  battlesAsB      PkBattle[]           @relation("BattleRoomB")
  battlesWon      PkBattle[]           @relation("BattleWinner")
  recommendations UserRecommendation[]

  @@index([status, viewerCount(sort: Desc)])
  @@map("rooms")
}

enum PkBattleStatus {
  invited
  live
  declined
  cancelled
  ended
}

// Translated from supabase/migrations/20260924200000_pk_battles.sql. Each host
// keeps publishing to their own IVS channel — no channel merge; viewers on
// either side additionally play the opponent's playback URL client-side
// while the battle is live. Score sync from gifts happens in the gift-send
// flow (Phase 5), mirroring the SQL trigger on `gifts`.
model PkBattle {
  id           String         @id @default(cuid())
  roomAId      String         @map("room_a_id")
  roomBId      String         @map("room_b_id")
  status       PkBattleStatus @default(invited)
  scoreA       BigInt         @default(0) @map("score_a")
  scoreB       BigInt         @default(0) @map("score_b")
  winnerRoomId String?        @map("winner_room_id")
  invitedAt    DateTime       @default(now()) @map("invited_at")
  startedAt    DateTime?      @map("started_at")
  endsAt       DateTime?      @map("ends_at")
  endedAt      DateTime?      @map("ended_at")

  roomA          Room   @relation("BattleRoomA", fields: [roomAId], references: [id], onDelete: Cascade)
  roomB          Room   @relation("BattleRoomB", fields: [roomBId], references: [id], onDelete: Cascade)
  winnerRoom     Room?  @relation("BattleWinner", fields: [winnerRoomId], references: [id])
  currentOfRooms Room[] @relation("CurrentBattle")

  @@index([roomAId])
  @@index([roomBId])
  @@map("pk_battles")
}

// Backs the atomic HOST-00000001-style codes generated by host_code_seq in
// core.sql — Prisma has no direct sequence primitive, so this row is
// incremented inside a transaction by HostsService.
model Counter {
  name  String @id
  value Int    @default(0)

  @@map("counters")
}

model Stream {
  id          String    @id @default(cuid())
  roomId      String    @map("room_id")
  hostId      String    @map("host_id")
  title       String
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  peakViewers Int       @default(0) @map("peak_viewers")
  giftCoins   BigInt    @default(0) @map("gift_coins")
  poolCoins   BigInt    @default(0) @map("pool_coins")
  aiSummary   Json?     @map("ai_summary")

  room          Room      @relation("RoomStreams", fields: [roomId], references: [id], onDelete: Cascade)
  currentOfRoom Room?     @relation("CurrentStream")
  host          Host      @relation(fields: [hostId], references: [userId], onDelete: Cascade)
  viewers       Viewer[]
  messages      Message[]
  gifts         Gift[]
  recordings    MediaAsset[]

  @@index([hostId, startedAt(sort: Desc)])
  @@map("streams")
}

model RoomAdmin {
  roomId    String   @map("room_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@map("room_admins")
}

model RoomBan {
  roomId    String    @map("room_id")
  userId    String    @map("user_id")
  kind      String // mute | kick | block
  expiresAt DateTime? @map("expires_at")
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, userId, kind])
  @@map("room_bans")
}

model Viewer {
  streamId String    @map("stream_id")
  userId   String    @map("user_id")
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([streamId, userId])
  @@map("viewers")
}

// ---- Social ---------------------------------------------------------------

model Follow {
  followerId String   @map("follower_id")
  followeeId String   @map("followee_id")
  createdAt  DateTime @default(now()) @map("created_at")

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId])
  @@map("follows")
}

model UserBlock {
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("user_blocks")
}

model Message {
  id         BigInt   @id @default(autoincrement())
  roomId     String   @map("room_id")
  streamId   String?  @map("stream_id")
  senderId   String   @map("sender_id")
  body       String
  status     String   @default("visible") // visible | hidden
  moderation Json?
  createdAt  DateTime @default(now()) @map("created_at")

  room         Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  stream       Stream?              @relation(fields: [streamId], references: [id])
  sender       User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)
  translations MessageTranslation[]

  @@index([roomId, createdAt(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc)])
  @@map("messages")
}

model DirectMessage {
  id          BigInt    @id @default(autoincrement())
  senderId    String    @map("sender_id")
  recipientId String    @map("recipient_id")
  body        String
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  sender    User @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("DmRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc)])
  @@map("direct_messages")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String?
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("platform_settings")
}

// ---- Economy ----------------------------------------------------------

model Wallet {
  userId      String   @id @map("user_id")
  coinBalance BigInt   @default(0) @map("coin_balance")
  frozen      Boolean  @default(false)
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model CoinTransaction {
  id             BigInt      @id @default(autoincrement())
  userId         String      @map("user_id")
  delta          BigInt
  balanceAfter   BigInt      @map("balance_after")
  kind           CoinTxnKind
  refType        String?     @map("ref_type")
  refId          String?     @map("ref_id")
  idempotencyKey String      @unique @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("coin_transactions")
}

model GiftCatalogItem {
  id        Int     @id @default(autoincrement())
  name      String
  icon      String
  coinPrice Int     @map("coin_price")
  active    Boolean @default(true)
  sort      Int     @default(0)
  // Presentation only (price still comes from here in sendGift); null = everywhere.
  regions   String[]

  gifts Gift[]

  @@map("gift_catalog")
}

model Gift {
  id             String   @id @default(cuid())
  roomId         String   @map("room_id")
  streamId       String?  @map("stream_id")
  senderId       String   @map("sender_id")
  hostId         String   @map("host_id")
  giftId         Int      @map("gift_id")
  quantity       Int
  coinsTotal     BigInt   @map("coins_total")
  hostShare      BigInt   @map("host_share")
  streamShare    BigInt   @map("stream_share")
  ownerShare     BigInt   @map("owner_share")
  idempotencyKey String   @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  room        Room            @relation(fields: [roomId], references: [id])
  stream      Stream?         @relation(fields: [streamId], references: [id])
  sender      User            @relation(fields: [senderId], references: [id])
  host        Host            @relation(fields: [hostId], references: [userId])
  catalogItem GiftCatalogItem @relation(fields: [giftId], references: [id])

  @@unique([idempotencyKey])
  @@map("gifts")
}

model CreatorEarning {
  hostId    String   @id @map("host_id")
  balance   BigInt   @default(0)
  held      BigInt   @default(0)
  lifetime  BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  host Host @relation(fields: [hostId], references: [userId], onDelete: Cascade)

  @@map("creator_earnings")
}

model EarningEntry {
  id        BigInt   @id @default(autoincrement())
  hostId    String   @map("host_id")
  delta     BigInt
  kind      String // gift | withdrawal_hold | withdrawal_release | withdrawal_paid | adjustment
  refId     String?  @map("ref_id")
  createdAt DateTime @default(now()) @map("created_at")

  host Host @relation(fields: [hostId], references: [userId], onDelete: Cascade)

  @@index([hostId, createdAt(sort: Desc)])
  @@map("earning_entries")
}

model PlatformLedger {
  id        BigInt   @id @default(autoincrement())
  bucket    String
  unit      String // coins | minor
  currency  String?
  amount    BigInt
  refType   String?  @map("ref_type")
  refId     String?  @map("ref_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("platform_ledger")
}

model CoinPackage {
  id         Int     @id @default(autoincrement())
  name       String
  coins      BigInt
  priceMinor BigInt  @map("price_minor")
  currency   String  @default("pkr")
  active     Boolean @default(true)
  sort       Int     @default(0)
  // Buyers only get their own region's packages (createPayment enforces it).
  regionCode String  @default("PK") @map("region")

  region   Region    @relation(fields: [regionCode], references: [code])
  payments Payment[]

  @@map("coin_packages")
}

model Payment {
  id                 String        @id @default(cuid())
  userId             String        @map("user_id")
  provider           String        @default("stripe")
  providerRef        String?       @map("provider_ref")
  providerPaymentRef String?       @map("provider_payment_ref")
  packageId          Int?          @map("package_id")
  coins              BigInt
  amountMinor        BigInt        @map("amount_minor")
  currency           String
  agencyId           String?       @map("agency_id")
  status             PaymentStatus @default(pending)
  paidAt             DateTime?     @map("paid_at")
  createdAt          DateTime      @default(now()) @map("created_at")

  user    User         @relation(fields: [userId], references: [id])
  package CoinPackage? @relation(fields: [packageId], references: [id])
  agency  Agency?      @relation(fields: [agencyId], references: [id])

  refundRequest RefundRequest?

  @@unique([provider, providerRef])
  @@index([userId, createdAt(sort: Desc)])
  @@index([providerPaymentRef])
  @@map("payments")
}

model ProcessedWebhookEvent {
  provider    String
  eventId     String   @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([provider, eventId])
  @@map("processed_webhook_events")
}

model RefundRequest {
  id         String   @id @default(cuid())
  paymentId  String   @unique @map("payment_id")
  userId     String   @map("user_id")
  reason     String
  status     String   @default("requested") // requested | approved | denied
  reviewedBy String?  @map("reviewed_by")
  createdAt  DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("refund_requests")
}

model Withdrawal {
  id           String           @id @default(cuid())
  hostId       String           @map("host_id")
  coins        BigInt
  amountMinor  BigInt           @map("amount_minor")
  currency     String           @default("pkr")
  payoutMethod Json             @map("payout_method")
  status       WithdrawalStatus @default(requested)
  reviewedBy   String?          @map("reviewed_by")
  reviewNote   String?          @map("review_note")
  payoutRef    String?          @map("payout_ref")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  host Host @relation(fields: [hostId], references: [userId])

  @@map("withdrawals")
}

// Minimal slice of moderation_actions from 20260924030000_moderation_ai.sql —
// just enough for PaymentsService to flag an account after an unrecoverable
// chargeback/refund shortfall. The full action ladder (warnings, temp/perm
// bans, reports, AI proposals) is Phase 6 (see docs/MIGRATION_PLAN.md).
model ModerationAction {
  id           BigInt    @id @default(autoincrement())
  targetUserId String    @map("target_user_id")
  action       String // warning | temp_restriction | temp_ban | permanent_ban | content_removal | account_review
  reason       String
  expiresAt    DateTime? @map("expires_at")
  actorId      String?   @map("actor_id")
  source       String // admin | ai | system | room_admin
  reportId     String?   @map("report_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  report Report? @relation(fields: [reportId], references: [id])

  @@index([targetUserId, createdAt(sort: Desc)])
  @@map("moderation_actions")
}

// ---- Moderation & AI (20260924030000_moderation_ai.sql) -------------------

model Report {
  id           String   @id @default(cuid())
  reporterId   String   @map("reporter_id")
  targetType   String   @map("target_type") // user | room | message
  targetId     String   @map("target_id")
  targetUserId String?  @map("target_user_id")
  reason       String
  status       String   @default("open") // open | reviewing | actioned | dismissed
  aiAssessment Json?    @map("ai_assessment")
  createdAt    DateTime @default(now()) @map("created_at")

  moderationActions ModerationAction[]

  @@index([status, createdAt(sort: Desc)])
  @@index([targetUserId])
  @@map("reports")
}

model AiJob {
  id        BigInt    @id @default(autoincrement())
  kind      String // moderate_message | moderate_report | fraud_review | fraud_sweep | support_ticket | creator_assist | translate_message | recommendations | ceo_briefing | media_process | media_subtitles
  payload   Json      @default("{}")
  status    String    @default("queued") // queued | running | done | failed
  attempts  Int       @default(0)
  runAfter  DateTime  @default(now()) @map("run_after")
  lockedAt  DateTime? @map("locked_at")
  dedupeKey String?   @unique @map("dedupe_key")
  result    Json?
  error     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([status, runAfter])
  @@map("ai_jobs")
}

model AiReport {
  id        BigInt   @id @default(autoincrement())
  kind      String
  headline  String
  summary   String
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, createdAt(sort: Desc)])
  @@map("ai_reports")
}

// AI never executes high-impact actions directly: it proposes, an owner
// approves, and the worker executes the approved action.
model AiAction {
  id           BigInt   @id @default(autoincrement())
  agent        String
  actionType   String   @map("action_type") // warning | temp_restriction | temp_ban | permanent_ban | account_review | freeze_wallet | unfreeze_wallet | note
  targetUserId String?  @map("target_user_id")
  rationale    String
  confidence   Float?
  params       Json     @default("{}")
  status       String   @default("proposed") // proposed | approved | rejected | executed | failed
  reviewedBy   String?  @map("reviewed_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)])
  @@map("ai_actions")
}

model MessageTranslation {
  messageId BigInt   @map("message_id")
  language  String
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, language])
  @@map("message_translations")
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  subject   String
  body      String
  category  String?
  status    String   @default("open") // open | answered | escalated | closed
  aiReply   String?  @map("ai_reply")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("support_tickets")
}

model UserRecommendation {
  userId    String   @map("user_id")
  roomId    String   @map("room_id")
  score     Float
  reason    String?
  updatedAt DateTime @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@map("user_recommendations")
}

model WordFilter {
  term   String @id
  action String @default("mask") // mask | block

  @@map("word_filters")
}

// ---- Regional variants ----------------------------------------------------
// Translated from supabase/migrations/20260925030000_regions_events.sql.

model Region {
  code            String   @id
  name            String
  countries       String[]
  currency        String
  defaultLanguage String   @map("default_language")
  languages       String[]
  timezone        String
  features        Json     @default("{}")
  active          Boolean  @default(false)
  sort            Int      @default(0)

  coinPackages CoinPackage[]
  events       Event[]

  @@map("regions")
}

// ---- Media: upload / live-recording → HDR pipeline -------------------------
// Translated from supabase/migrations/20260925010000_media_pipeline.sql and
// 20260925020000_media_subtitles.sql. Sources live in the private uploads
// bucket under <owner id>/; the media worker writes HLS outputs under <asset id>/.

enum MediaStatus {
  awaiting_upload
  queued
  processing
  ready
  failed
  removed
}

enum DynamicRange {
  sdr
  hdr10
  hlg
}

model MediaAsset {
  id             String        @id @default(cuid())
  ownerId        String        @map("owner_id")
  sourceKind     String        @default("upload") @map("source_kind") // upload | live_recording
  streamId       String?       @map("stream_id")
  recordingRef   String?       @unique @map("egress_id") // LiveKit egress id / IVS recording session id
  title          String
  description    String?
  visibility     String        @default("public") // public | unlisted
  sourcePath     String        @unique @map("source_path")
  status         MediaStatus   @default(awaiting_upload)
  durationMs     BigInt?       @map("duration_ms")
  width          Int?
  height         Int?
  fps            Decimal?      @db.Decimal(6, 3)
  videoCodec     String?       @map("video_codec")
  bitDepth       Int?          @map("bit_depth")
  colorPrimaries String?       @map("color_primaries")
  colorTransfer  String?       @map("color_transfer")
  colorSpace     String?       @map("color_space")
  dynamicRange   DynamicRange? @map("dynamic_range")
  hdrMetadata    Json?         @map("hdr_metadata")
  hasAudio       Boolean?      @map("has_audio")
  playbackPath   String?       @map("playback_path")
  thumbnailPath  String?       @map("thumbnail_path")
  subtitleStatus String?       @map("subtitle_status") // pending | done | no_speech | failed
  error          String?
  viewCount      BigInt        @default(0) @map("view_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  publishedAt    DateTime?     @map("published_at")

  owner      Host             @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
  stream     Stream?          @relation(fields: [streamId], references: [id], onDelete: SetNull)
  renditions MediaRendition[]
  views      MediaView[]
  subtitles  MediaSubtitle[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([status, visibility, publishedAt(sort: Desc)])
  @@map("media_assets")
}

model MediaRendition {
  assetId      String       @map("asset_id")
  label        String // 2160p_hdr, 1080p_hdr, 1080p, 720p, ...
  width        Int
  height       Int
  bitrateKbps  Int          @map("bitrate_kbps")
  codecs       String
  dynamicRange DynamicRange @map("dynamic_range")
  playlistPath String       @map("playlist_path")

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([assetId, label])
  @@map("media_renditions")
}

model MediaView {
  assetId   String   @map("asset_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([assetId, userId])
  @@map("media_views")
}

model MediaSubtitle {
  assetId      String   @map("asset_id")
  language     String
  name         String
  isSource     Boolean  @default(false) @map("is_source")
  vttPath      String   @map("vtt_path")
  playlistPath String   @map("playlist_path")
  createdAt    DateTime @default(now()) @map("created_at")

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([assetId, language])
  @@map("media_subtitles")
}

// ---- Engagement events ------------------------------------------------------

enum EventKind {
  gifting
  pk_battle
}

enum EventStatus {
  draft
  scheduled
  cancelled
  finalized
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String?
  kind        EventKind
  regionCode  String?     @map("region") // null = global
  startsAt    DateTime    @map("starts_at")
  endsAt      DateTime    @map("ends_at")
  giftIds     Int[]       @map("gift_ids") // empty = all gifts
  rewards     Json        @default("[]") // [{ role, rank_from, rank_to, reward }]
  status      EventStatus @default(draft)
  createdBy   String?     @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  finalizedAt DateTime?   @map("finalized_at")

  region  Region?       @relation(fields: [regionCode], references: [code])
  scores  EventScore[]
  results EventResult[]

  @@index([status, startsAt, endsAt])
  @@map("events")
}

model EventScore {
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  role      String // host | gifter
  score     BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, role, userId])
  @@index([eventId, role, score(sort: Desc)])
  @@map("event_scores")
}

model EventResult {
  eventId String  @map("event_id")
  role    String
  rank    Int
  userId  String  @map("user_id")
  score   BigInt
  reward  String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, role, rank])
  @@map("event_results")
}

// Mirrors public.audit_logs / private.audit() in core.sql. Used by the
// admin actions ported so far (events, media takedowns).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id")
  actorKind  String   @default("user") @map("actor_kind") // user | ai | system
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
